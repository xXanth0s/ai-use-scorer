{
  "name": "how-do-you-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "npm run plugin:build && next build",
    "start": "next start --hostname 127.0.0.1",
    "collect": "node --import tsx scripts/collect.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "daily": "node --import tsx scripts/daily.ts",
    "platform:admin": "node --env-file=services/analysis/.env.local --import tsx scripts/platform-admin.ts",
    "analysis:migrate": "node --env-file=services/analysis/.env.local --import tsx scripts/migrate-analysis.ts",
    "analysis:build": "npm --prefix services/analysis run build",
    "analysis:check-access": "node --env-file=services/analysis/.env.local --import tsx scripts/check-analysis-access.ts",
    "entire:enable": "node --import tsx scripts/enable-entire.ts",
    "plugin:build": "node --import tsx scripts/build-plugin.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.79",
    "@clerk/nextjs": "^7.9.15",
    "@neondatabase/serverless": "^1.2.0",
    "ai": "^7.0.140",
    "eve": "^0.79.1",
    "lucide-react": "^0.468.0",
    "next": "^16.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.28.2",
    "typescript": "^5.9.0"
  },
  "type": "module",
  "engines": {
    "node": "24.x"
  }
}
